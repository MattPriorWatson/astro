---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About | Film Colourist Portfolio" description="Professional background, grading suite setup, and technical specifications of the colourist." />
	</head>
	<body>
		<Header />
		<main>
			<section class="about-hero">
				<h1>About Me</h1>
				<p class="subtitle">Senior Film Colourist</p>
			</section>

			<div class="about-content">
				<div class="bio-text">
					<p>
						With over a decade of experience in post-production, I specialize in crafting distinctive visual identities for feature films, high-end commercials, and music videos. My approach blends technical precision with deep narrative empathy, ensuring every frame serves the emotional core of the story.
					</p>
					<p>
						Whether working in ACES or DaVinci Wide Gamut, I collaborate closely with directors and cinematographers from pre-production look development through to final delivery, ensuring seamless continuity and striking cinematic contrast.
					</p>
				</div>

				<div class="specs-box">
					<h2>Suite & Hardware Specifications</h2>
					<ul>
						<li><strong>Software:</strong> DaVinci Resolve Studio / Baselight</li>
						<li><strong>Monitoring:</strong> Flanders Scientific (FSI) Calibrated Reference Display</li>
						<li><strong>Environment:</strong> D65 Spectrally Balanced Controlled Lighting Environment (Rec. 709 / DCI-P3 / Rec. 2020)</li>
						<li><strong>Control Surface:</strong> DaVinci Resolve Advanced Panel</li>
					</ul>
				</div>
			</div>
		</main>
		<Footer />

		<style>
			main {
				max-width: 900px;
				margin: 0 auto;
				padding: 8em 2em 4em 2em;
			}
			.about-hero {
				margin-bottom: 3rem;
			}
			.about-hero h1 {
				font-size: 3rem;
				margin-bottom: 0.5rem;
			}
			.subtitle {
				font-size: 1.15rem;
				color: var(--accent);
				font-weight: 500;
				margin: 0;
			}
			.about-content {
				display: flex;
				flex-direction: column;
				gap: 3rem;
			}
			.bio-text p {
				font-size: 1.1rem;
				line-height: 1.8;
				color: #d1d5db;
			}
			.specs-box {
				background: rgb(var(--gray-light));
				padding: 2.5rem;
				border-radius: 8px;
				border: 1px solid rgba(255, 255, 255, 0.05);
			}
			.specs-box h2 {
				font-size: 1.5rem;
				margin-bottom: 1.5rem;
				color: rgb(var(--black));
			}
			.specs-box ul {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			.specs-box li {
				color: var(--gray);
				font-size: 0.95rem;
			}
			.specs-box strong {
				color: rgb(var(--black));
				margin-right: 0.5rem;
			}
			@media (max-width: 768px) {
				main {
					padding: 7em 1em 3em 1em;
				}
				.specs-box {
					padding: 1.5rem;
				}
			}
		</style>
	</body>
</html>