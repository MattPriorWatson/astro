---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

const { profileImage, profileAlt, cvUrl } = site;
---

<BaseLayout
	title="About | Film Colourist Portfolio"
	description="Professional background and approach of the colourist."
	width="narrow"
>
	<header class="page-header">
		<span class="eyebrow">Senior Film Colourist</span>
		<h1>About</h1>
	</header>

	<div class="about">
		{
			profileImage && (
				<img class="portrait" src={profileImage} alt={profileAlt} width="480" height="600" />
			)
		}

		<div class="bio">
			<p>
				With over a decade of experience in post-production, I specialize in crafting distinctive visual identities for feature films, high-end commercials, and music videos. My approach blends technical precision with deep narrative empathy, ensuring every frame serves the emotional core of the story.
			</p>
			<p>
				Whether working in ACES or DaVinci Wide Gamut, I collaborate closely with directors and cinematographers from pre-production look development through to final delivery, ensuring seamless continuity and striking cinematic contrast.
			</p>

			{
				cvUrl && (
					<a class="button" href={cvUrl} target="_blank" rel="noopener noreferrer">
						View CV
						<span class="sr-only"> (opens in a new tab)</span>
					</a>
				)
			}
		</div>
	</div>
</BaseLayout>

<style>
	.about {
		display: grid;
		grid-template-columns: minmax(0, 220px) 1fr;
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: start;
	}
	.portrait {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		background: #000;
	}
	.bio p {
		font-size: var(--text-lg);
		line-height: 1.8;
	}
	.button {
		display: inline-block;
		margin-top: 1rem;
		padding: 0.9em 1.8em;
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.16em;
		line-height: 1;
		color: var(--text);
		border: 1px solid var(--text);
		transition: background-color 0.2s ease, color 0.2s ease;
	}
	.button:hover {
		background: var(--text);
		color: var(--bg);
		opacity: 1;
	}
	@media (max-width: 640px) {
		.about {
			grid-template-columns: 1fr;
		}
		.portrait {
			max-width: 260px;
		}
	}
</style>