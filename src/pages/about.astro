---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

const { profileImage, profileAlt, cvUrl } = site;
---

<BaseLayout
	title="About | Portfolio"
	description="Brief description of about page."
	width="narrow"
>
	<header class="page-header">
		<span class="eyebrow">Job Title</span>	
		<h1>About</h1>
	</header>

	<div class="about">
		{
			profileImage && (
				<img class="portrait" src={profileImage} alt={profileAlt} width="480" height="600" />
			)
		}

		<div class="bio">
			<p>
				Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum 
			</p>
			<p>
				Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum Lorem Ipsum 
			</p>

			{
				cvUrl && (
					<a class="button" href={cvUrl} target="_blank" rel="noopener noreferrer">
						View CV
						<span class="sr-only"> (opens in a new tab)</span>
					</a>
				)
			}
		</div>
	</div>
</BaseLayout>

<style>
	.about {
		display: grid;
		grid-template-columns: minmax(0, 220px) 1fr;
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: start;
	}
	.portrait {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		background: #000;
	}
	.bio p {
		font-size: var(--text-lg);
		line-height: 1.8;
	}
	.button {
		display: inline-block;
		margin-top: 1rem;
		padding: 0.9em 1.8em;
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.16em;
		line-height: 1;
		color: var(--text);
		border: 1px solid var(--text);
		transition: background-color 0.2s ease, color 0.2s ease;
	}
	.button:hover {
		background: var(--text);
		color: var(--bg);
		opacity: 1;
	}
	@media (max-width: 640px) {
		.about {
			grid-template-columns: 1fr;
		}
		.portrait {
			max-width: 260px;
		}
	}
</style>