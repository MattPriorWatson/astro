---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="About | Film Colourist Portfolio"
	description="Professional background, grading suite setup, and technical specifications of the colourist."
	width="narrow"
>
	<header class="page-header">
		<span class="eyebrow">Senior Film Colourist</span>
		<h1>About</h1>
	</header>

	<div class="bio">
		<p>
			With over a decade of experience in post-production, I specialize in crafting distinctive visual identities for feature films, high-end commercials, and music videos. My approach blends technical precision with deep narrative empathy, ensuring every frame serves the emotional core of the story.
		</p>
		<p>
			Whether working in ACES or DaVinci Wide Gamut, I collaborate closely with directors and cinematographers from pre-production look development through to final delivery, ensuring seamless continuity and striking cinematic contrast.
		</p>
	</div>

	<section aria-labelledby="specs-heading">
		<h2 id="specs-heading" class="section-title">Suite &amp; Hardware</h2>
		<dl>
			<div>
				<dt>Software</dt>
				<dd>DaVinci Resolve Studio / Baselight</dd>
			</div>
			<div>
				<dt>Monitoring</dt>
				<dd>Flanders Scientific (FSI) Calibrated Reference Display</dd>
			</div>
			<div>
				<dt>Environment</dt>
				<dd>D65 Spectrally Balanced Controlled Lighting Environment (Rec. 709 / DCI-P3 / Rec. 2020)</dd>
			</div>
			<div>
				<dt>Control Surface</dt>
				<dd>DaVinci Resolve Advanced Panel</dd>
			</div>
		</dl>
	</section>
</BaseLayout>

<style>
	.bio {
		margin-bottom: clamp(3rem, 8vw, 5rem);
	}
	.bio p {
		font-size: var(--text-lg);
		line-height: 1.8;
	}
	dl {
		display: grid;
		gap: 1.25rem;
		margin: 1.5rem 0 0;
	}
	dl > div {
		display: grid;
		grid-template-columns: 9rem 1fr;
		gap: 0.25rem 1.5rem;
	}
	dt {
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: var(--text-muted);
		padding-top: 0.35em;
	}
	dd {
		margin: 0;
		color: var(--text-body);
	}
	@media (max-width: 560px) {
		dl > div {
			grid-template-columns: 1fr;
		}
	}
</style>
