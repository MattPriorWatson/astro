---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const uniqueCategories = [...new Set(projects.map((p) => p.data.category))];
// Only show the filter when there is something to filter between
const categories = uniqueCategories.length > 1 ? ['All', ...uniqueCategories] : [];
---

<BaseLayout
	title="Work | Film Colourist Portfolio"
	description="Selected color grading projects across commercials, feature films, and music videos."
	width="wide"
>
	<header class="page-header">
		<h1>Selected Work</h1>
	</header>

	{
		categories.length > 0 && (
			<div class="filter-bar" role="group" aria-label="Filter projects by category">
				{categories.map((cat, index) => (
					<button type="button" class="filter-btn" data-category={cat} aria-pressed={index === 0 ? 'true' : 'false'}>
						{cat}
					</button>
				))}
			</div>
		)
	}

	<p id="filter-status" class="sr-only" role="status" aria-live="polite"></p>

	{
		projects.length > 0 ? (
			<div class="projects-grid" id="projects-grid">
				{projects.map((project, i) => (
					<ProjectCard project={project} showClient eager={i < 2} />
				))}
			</div>
		) : (
			<p class="empty-state">No projects yet — check back soon.</p>
		)
	}

	<p id="filter-empty" class="empty-state" hidden>No projects in this category yet.</p>
</BaseLayout>

<style>
	.filter-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
	}
	.filter-btn {
		font: inherit;
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.04em;
		line-height: 1;
		min-height: 40px;
		padding: 0.7em 1.3em;
		background: transparent;
		color: var(--text-muted);
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		cursor: pointer;
		transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}
	.filter-btn:hover {
		color: var(--text);
		border-color: var(--text-muted);
	}
	.filter-btn[aria-pressed='true'] {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}
</style>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
	const cards = document.querySelectorAll<HTMLElement>('#projects-grid .project-card');
	const status = document.getElementById('filter-status');
	const empty = document.getElementById('filter-empty');

	function applyFilter(category: string) {
		let visible = 0;
		cards.forEach((card) => {
			const show = category === 'All' || card.dataset.category === category;
			card.hidden = !show;
			if (show) visible++;
		});
		if (empty) empty.hidden = visible !== 0;
		if (status) status.textContent = `Showing ${visible} ${visible === 1 ? 'project' : 'projects'}${category === 'All' ? '' : ` in ${category}`}`;
	}

	buttons.forEach((btn) => {
		btn.addEventListener('click', () => {
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
			applyFilter(btn.dataset.category ?? 'All');
		});
	});
</script>
