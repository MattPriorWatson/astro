---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Contact | Film Colourist Portfolio"
	description="Get in touch for color grading bookings, rates, and project inquiries."
	width="narrow"
>
	<header class="page-header">
		<h1>Get in Touch</h1>
		<p>Available for local suites and remote color grading workflows worldwide.</p>
	</header>

	<div class="panel contact">
		<section>
			<h2 class="label">Direct Inquiries</h2>
			<p><a href="mailto:colorist@example.com" class="email-link">colorist@example.com</a></p>
		</section>

		<section>
			<h2 class="label">Location &amp; Timezone</h2>
			<p>Based in London • Available Worldwide (GMT/UTC)</p>
		</section>

		<section>
			<h2 class="label">Representation</h2>
			<p><strong>Agency:</strong> Vision Artists</p>
			<p><strong>Booking Agent:</strong> <a href="mailto:agent@visionartists.com">agent@visionartists.com</a></p>
		</section>

		<section>
			<h2 class="label">Profiles</h2>
			<ul class="social-links">
				<li><a href="https://vimeo.com" target="_blank" rel="noopener noreferrer">Vimeo<span class="sr-only"> (opens in a new tab)</span></a></li>
				<li><a href="https://instagram.com" target="_blank" rel="noopener noreferrer">Instagram<span class="sr-only"> (opens in a new tab)</span></a></li>
				<li><a href="https://imdb.com" target="_blank" rel="noopener noreferrer">IMDb<span class="sr-only"> (opens in a new tab)</span></a></li>
			</ul>
		</section>
	</div>
</BaseLayout>

<style>
	.contact {
		display: grid;
		gap: 0;
	}
	.contact section {
		padding-block: 1.75rem;
		border-bottom: 1px solid var(--border);
	}
	.contact section:first-child {
		padding-top: 0;
	}
	.contact section:last-child {
		padding-bottom: 0;
		border-bottom: 0;
	}
	.label {
		margin: 0 0 0.5rem;
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.contact p {
		margin: 0 0 0.25rem;
		color: var(--text);
		font-size: var(--text-lg);
	}
	.contact strong {
		color: var(--text-muted);
		font-weight: 400;
		margin-right: 0.35em;
	}
	.email-link {
		font-size: clamp(1.25rem, 1rem + 1.5vw, 1.75rem);
		font-weight: 700;
		overflow-wrap: anywhere;
	}
	.email-link:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.social-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.social-links a {
		color: var(--text);
		font-size: var(--text-lg);
	}
	.social-links a:hover {
		color: var(--accent-text);
	}
</style>
