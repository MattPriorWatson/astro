---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Contact | Film Colourist Portfolio" description="Get in touch for color grading bookings, rates, and project inquiries." />
	</head>
	<body>
		<Header />
		<main>
			<section class="contact-header">
				<h1>Get in Touch</h1>
				<p>Available for local suites and remote color grading workflows worldwide.</p>
			</section>

			<div class="contact-grid">
				<!-- Booking Inquiry Form -->
				<form class="contact-form" action="#" method="POST">
					<div class="form-group">
						<label for="name">Name</label>
						<input type="text" id="name" name="name" placeholder="Your name" required />
					</div>

					<div class="form-group">
						<label for="email">Email</label>
						<input type="email" id="email" name="email" placeholder="your.email@example.com" required />
					</div>

					<div class="form-group">
						<label for="project-type">Project Type</label>
						<select id="project-type" name="project-type">
							<option value="commercial">Commercial</option>
							<option value="feature">Feature Film / Narrative</option>
							<option value="music-video">Music Video</option>
							<option value="documentary">Documentary</option>
							<option value="other">Other</option>
						</select>
					</div>

					<div class="form-group">
						<label for="message">Project Details & Timeline</label>
						<textarea id="message" name="message" rows="5" placeholder="Tell me about the project, camera formats, timeline, and budget..." required></textarea>
					</div>

					<button type="submit" class="submit-btn">Send Inquiry</button>
				</form>

				<!-- Direct Details & Representation -->
				<div class="contact-info">
					<div class="info-block">
						<h3>Direct Contact</h3>
						<p><a href="mailto:colorist@example.com">colorist@example.com</a></p>
					</div>

					<div class="info-block">
						<h3>Location & Timezone</h3>
						<p>Based in London / Available Worldwide (GMT/UTC)</p>
					</div>

					<div class="info-block">
						<h3>Representation / Agent</h3>
						<p><strong>Agency Name:</strong> Vision Artists</p>
						<p><strong>Agent Email:</strong> agent@visionartists.com</p>
					</div>

					<div class="info-block">
						<h3>Profiles</h3>
						<div class="social-links">
							<a href="https://vimeo.com" target="_blank" rel="noopener">Vimeo</a>
							<a href="https://instagram.com" target="_blank" rel="noopener">Instagram</a>
							<a href="https://imdb.com" target="_blank" rel="noopener">IMDb</a>
						</div>
					</div>
				</div>
			</div>
		</main>
		<Footer />

		<style>
			main {
				max-width: 1100px;
				margin: 0 auto;
				padding: 8em 2em 4em 2em;
			}
			.contact-header {
				margin-bottom: 3rem;
			}
			.contact-header h1 {
				font-size: 3rem;
				margin-bottom: 0.5rem;
			}
			.contact-header p {
				color: var(--gray);
				font-size: 1.1rem;
				margin: 0;
			}
			.contact-grid {
				display: grid;
				grid-template-columns: 1.2fr 0.8fr;
				gap: 4rem;
			}
			.contact-form {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}
			.form-group {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}
			label {
				font-size: 0.85rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: var(--gray);
			}
			input, select, textarea {
				background: rgb(var(--gray-light));
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-radius: 6px;
				padding: 0.85em 1em;
				color: rgb(var(--black));
				font-family: inherit;
				font-size: 0.95rem;
				outline: none;
				transition: border-color 0.2s ease;
			}
			input:focus, select:focus, textarea:focus {
				border-color: var(--accent);
			}
			.submit-btn {
				background: var(--accent);
				color: rgb(var(--black));
				border: none;
				padding: 1em 2em;
				border-radius: 6px;
				font-weight: 700;
				font-size: 0.95rem;
				cursor: pointer;
				transition: background-color 0.2s ease;
				margin-top: 0.5rem;
			}
			.submit-btn:hover {
				background: var(--accent-dark);
			}
			.contact-info {
				display: flex;
				flex-direction: column;
				gap: 2.5rem;
			}
			.info-block h3 {
				font-size: 1.1rem;
				margin-bottom: 0.5rem;
				color: rgb(var(--black));
			}
			.info-block p {
				color: var(--gray);
				margin: 0;
				font-size: 0.95rem;
			}
			.info-block strong {
				color: rgb(var(--black));
			}
			.social-links {
				display: flex;
				gap: 1.5rem;
			}
			.social-links a {
				color: var(--gray);
				font-size: 0.95rem;
				text-decoration: none;
				transition: color 0.2s ease;
			}
			.social-links a:hover {
				color: var(--accent);
			}
			@media (max-width: 860px) {
				main {
					padding: 7em 1em 3em 1em;
				}
				.contact-grid {
					grid-template-columns: 1fr;
					gap: 3rem;
				}
			}
		</style>
	</body>
</html>