---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Contact | Film Colourist Portfolio" description="Get in touch for color grading bookings, rates, and project inquiries." />
	</head>
	<body>
		<Header />
		<main>
			<section class="contact-header">
				<h1>Get in Touch</h1>
				<p>Available for local suites and remote color grading workflows worldwide.</p>
			</section>

			<div class="contact-container">
				<div class="info-block">
					<h3>Direct Inquiries</h3>
					<p><a href="mailto:colorist@example.com" class="email-link">colorist@example.com</a></p>
				</div>

				<div class="info-block">
					<h3>Location & Timezone</h3>
					<p>Based in London • Available Worldwide (GMT/UTC)</p>
				</div>

				<div class="info-block">
					<h3>Representation</h3>
					<p><strong>Agency:</strong> Vision Artists</p>
					<p><strong>Booking Agent:</strong> <a href="mailto:agent@visionartists.com">agent@visionartists.com</a></p>
				</div>

				<div class="info-block">
					<h3>Profiles</h3>
					<div class="social-links">
						<a href="https://vimeo.com" target="_blank" rel="noopener">Vimeo</a>
						<a href="https://instagram.com" target="_blank" rel="noopener">Instagram</a>
						<a href="https://imdb.com" target="_blank" rel="noopener">IMDb</a>
					</div>
				</div>
			</div>
		</main>
		<Footer />

		<style>
			main {
				max-width: 800px;
				margin: 0 auto;
				padding: 9em 2em 5em 2em;
			}
			.contact-header {
				margin-bottom: 4rem;
			}
			.contact-header h1 {
				font-size: 3rem;
				margin-bottom: 0.5rem;
				letter-spacing: -0.02em;
			}
			.contact-header p {
				color: var(--gray);
				font-size: 1.15rem;
				margin: 0;
			}
			.contact-container {
				display: flex;
				flex-direction: column;
				gap: 3rem;
				background: rgb(var(--gray-light));
				padding: 3rem;
				border-radius: 12px;
				border: 1px solid rgba(255, 255, 255, 0.05);
			}
			.info-block h3 {
				font-size: 0.85rem;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: var(--gray);
				margin-bottom: 0.5rem;
			}
			.info-block p {
				color: #fff;
				margin: 0;
				font-size: 1.1rem;
			}
			.email-link {
				font-size: 1.5rem;
				font-weight: 600;
				color: var(--accent);
				text-decoration: none;
			}
			.email-link:hover {
				text-decoration: underline;
			}
			.info-block strong {
				color: rgb(var(--black));
			}
			.social-links {
				display: flex;
				gap: 2rem;
				margin-top: 0.25rem;
			}
			.social-links a {
				color: #fff;
				font-size: 1.1rem;
				text-decoration: none;
				transition: color 0.2s ease;
			}
			.social-links a:hover {
				color: var(--accent);
			}
			@media (max-width: 768px) {
				main {
					padding: 7em 1em 3em 1em;
				}
				.contact-container {
					padding: 1.5rem;
				}
				.email-link {
					font-size: 1.2rem;
				}
			}
		</style>
	</body>
</html>