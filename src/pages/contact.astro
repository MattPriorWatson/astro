---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

const { socials } = site;
---

<BaseLayout
	title="Contact | Film Colourist Portfolio"
	description="Get in touch for color grading bookings, rates, and project inquiries."
	width="narrow"
>
	<header class="page-header">
		<h1>Contact</h1>
		<p>Available for local suites and remote color grading workflows worldwide.</p>
	</header>

	<div class="contact">
		<section>
			<h2 class="label contact-label">Direct Inquiries</h2>
			<p><a href="mailto:colorist@example.com" class="email-link">colorist@example.com</a></p>
		</section>

		<section>
			<h2 class="label contact-label">Location &amp; Timezone</h2>
			<p>Based in London • Available Worldwide (GMT/UTC)</p>
		</section>

		<section>
			<h2 class="label contact-label">Representation</h2>
			<p><span class="muted">Agency</span> Vision Artists</p>
			<p><span class="muted">Booking</span> <a href="mailto:agent@visionartists.com">agent@visionartists.com</a></p>
		</section>

		{
			socials.length > 0 && (
				<section>
					<h2 class="label contact-label">Profiles</h2>
					<ul class="social-links">
						{socials.map((s) => (
							<li>
								<a href={s.url} target="_blank" rel="noopener noreferrer">
									{s.label}
									<span class="sr-only"> (opens in a new tab)</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</div>
</BaseLayout>

<style>
	.contact {
		display: grid;
		gap: clamp(2rem, 5vw, 3rem);
	}
	.contact-label {
		margin-bottom: 0.5rem;
	}
	.contact p {
		margin: 0 0 0.25rem;
		color: var(--text);
		font-size: var(--text-lg);
	}
	.muted {
		display: inline-block;
		min-width: 5.5rem;
		color: var(--text-muted);
	}
	.email-link {
		font-size: clamp(1.25rem, 1rem + 1.5vw, 1.75rem);
		overflow-wrap: anywhere;
	}
	.social-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--text-lg);
	}
</style>