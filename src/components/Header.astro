---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header class="site-header">
	<nav class="site-nav" aria-label="Main">
		<a class="brand" href="/">{SITE_TITLE}</a>

		<button
			id="menu-toggle"
			class="menu-toggle"
			type="button"
			aria-label="Menu"
			aria-expanded="false"
			aria-controls="nav-links"
		>
			<span></span>
			<span></span>
		</button>

		<div class="nav-links" id="nav-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/credits" matches={['/projects']}>Credits</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 1000;
		padding-inline: var(--gutter);
	}

	/* Solid background fades in once the page has scrolled */
	.site-header::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--bg);
		opacity: 0;
		transition: opacity 0.2s ease;
	}
	.site-header.scrolled::before,
	:global(html.menu-open) .site-header::before {
		opacity: 1;
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: var(--width-wide);
		height: var(--header-h);
		margin-inline: auto;
	}

	.brand {
		position: relative;
		z-index: 11;
		color: var(--text);
		font-size: var(--text-base);
		letter-spacing: -0.01em;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 2.5rem;
	}
	.nav-links :global(a) {
		color: var(--text-muted);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.16em;
		padding: 0.5em 0;
		transition: color 0.2s ease;
	}
	.nav-links :global(a:hover) {
		color: var(--text);
		opacity: 1;
	}
	.nav-links :global(a.active) {
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 8px;
		text-decoration-thickness: 1px;
	}

	.menu-toggle {
		display: none;
		position: relative;
		z-index: 11;
		width: 44px;
		height: 44px;
		margin-right: -10px;
		padding: 0;
		background: transparent;
		border: 0;
		cursor: pointer;
		color: var(--text);
		align-items: center;
		justify-content: center;
		flex-direction: column;
		gap: 6px;
	}
	.menu-toggle span {
		display: block;
		width: 22px;
		height: 1px;
		background: currentColor;
		transition: transform 0.2s ease;
	}
	.menu-toggle[aria-expanded='true'] span:nth-child(1) {
		transform: translateY(3.5px) rotate(45deg);
	}
	.menu-toggle[aria-expanded='true'] span:nth-child(2) {
		transform: translateY(-3.5px) rotate(-45deg);
	}

	@media (max-width: 768px) {
		.menu-toggle {
			display: flex;
		}

		.nav-links {
			position: fixed;
			inset: 0;
			z-index: 10;
			height: 100vh;
			height: 100dvh;
			flex-direction: column;
			justify-content: center;
			gap: 2rem;
			background: var(--bg);
			/* hidden state removes links from tab order and the a11y tree */
			visibility: hidden;
			opacity: 0;
			transition: opacity 0.2s ease, visibility 0s linear 0.2s;
		}
		.nav-links.expanded {
			visibility: visible;
			opacity: 1;
			transition: opacity 0.2s ease, visibility 0s;
		}
		.nav-links :global(a) {
			font-size: 0.95rem;
		}
	}
</style>

<script>
	const header = document.querySelector<HTMLElement>('.site-header');
	const toggle = document.getElementById('menu-toggle');
	const links = document.getElementById('nav-links');
	const root = document.documentElement;

	function setMenu(open: boolean) {
		toggle?.setAttribute('aria-expanded', String(open));
		links?.classList.toggle('expanded', open);
		root.classList.toggle('menu-open', open);
	}

	toggle?.addEventListener('click', () => {
		setMenu(toggle.getAttribute('aria-expanded') !== 'true');
	});

	// Close on link click, Escape, or when resizing up to desktop
	links?.addEventListener('click', (e) => {
		if ((e.target as Element).closest('a')) setMenu(false);
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
			setMenu(false);
			toggle.focus();
		}
	});
	window
		.matchMedia('(min-width: 769px)')
		.addEventListener('change', (e) => e.matches && setMenu(false));

	// Solid background once the page has scrolled
	const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 30);
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();
</script>
