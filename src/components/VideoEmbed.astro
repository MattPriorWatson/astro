---
interface Props {
	src: string;
	title: string;
}

const { src, title } = Astro.props;

// Use the privacy-friendly YouTube domain when embedding YouTube
const safeSrc = src.replace('://www.youtube.com/', '://www.youtube-nocookie.com/');
---

<div class="video">
	<iframe
		src={safeSrc}
		title={title}
		loading="lazy"
		allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
		referrerpolicy="strict-origin-when-cross-origin"
		allowfullscreen></iframe>
</div>

<style>
	.video {
		position: relative;
		aspect-ratio: 16 / 9;
		background: #000;
	}
	iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
