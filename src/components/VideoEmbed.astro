---
interface Props {
	src: string;
	title: string;
	/** Optional poster image. For YouTube, the video thumbnail is used as fallback. */
	poster?: string;
}

const { src, title, poster } = Astro.props;

// Switch to privacy-enhanced YouTube domain
const safeSrc = src.replace('://www.youtube.com/', '://www.youtube-nocookie.com/');

// Extract YouTube video ID so we can use it as a thumbnail fallback
const ytId = safeSrc.match(/embed\/([^/?&#]+)/)?.[1];
const autoThumb = ytId ? `https://img.youtube.com/vi/${ytId}/maxresdefault.jpg` : undefined;
const thumbSrc = poster ?? autoThumb;

// When the user clicks play we want autoplay
const autoplaySrc = thumbSrc
	? `${safeSrc}${safeSrc.includes('?') ? '&' : '?'}autoplay=1`
	: undefined;
---

<div class="video">
	{
		thumbSrc && (
			<button class="video-facade" aria-label={`Play ${title}`}>
				<img
					src={thumbSrc}
					alt=""
					aria-hidden="true"
					class="video-thumb"
					width="1600"
					height="900"
					loading="lazy"
					decoding="async"
				/>
				<span class="play-icon" aria-hidden="true">
					<!-- Simple play circle — no external icon dep needed here -->
					<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" width="64" height="64">
						<circle cx="32" cy="32" r="32" fill="rgba(0,0,0,0.55)" />
						<polygon points="26,20 50,32 26,44" fill="white" />
					</svg>
				</span>
			</button>
		)
	}
	<iframe
		class={`video-iframe${thumbSrc ? ' js-deferred' : ''}`}
		src={thumbSrc ? undefined : safeSrc}
		data-src={autoplaySrc}
		title={title}
		loading={thumbSrc ? undefined : 'lazy'}
		allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen; autoplay"
		referrerpolicy="strict-origin-when-cross-origin"
		allowfullscreen
	></iframe>
</div>

<style>
	.video {
		position: relative;
		aspect-ratio: 16 / 9;
		background: #000;
		overflow: hidden;
	}
	/* Facade (thumbnail + play button) */
	.video-facade {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
	}
	.video-thumb {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.play-icon {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		transition: transform 0.2s ease;
	}
	.video-facade:hover .play-icon,
	.video-facade:focus-visible .play-icon {
		transform: scale(1.1);
	}
	/* Iframe */
	.video-iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
	.video-iframe.js-deferred {
		/* Keeps the iframe in the DOM but invisible until play is clicked */
		visibility: hidden;
	}
</style>

<script>
	document.querySelectorAll<HTMLDivElement>('.video').forEach((wrapper) => {
		const facade = wrapper.querySelector<HTMLButtonElement>('.video-facade');
		const iframe = wrapper.querySelector<HTMLIFrameElement>('.video-iframe.js-deferred');
		if (!facade || !iframe) return;

		facade.addEventListener(
			'click',
			() => {
				iframe.src = iframe.dataset.src ?? '';
				iframe.style.visibility = '';
				iframe.classList.remove('js-deferred');
				facade.remove();
			},
			{ once: true },
		);
	});
</script>
