---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} All rights reserved.</p>
</footer>

<style>
	footer {
		padding: 3em 1em;
		text-align: center;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		margin-top: 4em;
	}

	p {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.85rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
</style>