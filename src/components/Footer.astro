---
import { SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container">
		<p>&copy; {year} {SITE_TITLE}</p>
	</div>
</footer>

<style>
	.site-footer {
		padding-block: 3rem;
	}
	p {
		margin: 0;
		color: var(--text-muted);
		font-size: var(--text-xs);
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
</style>
