---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
	/** Set true for above-the-fold cards so the image isn't lazy-loaded. */
	eager?: boolean;
	showClient?: boolean;
}

const { project, eager = false, showClient = false } = Astro.props;
const { title, category, client, heroImage } = project.data;
---

<a href={`/projects/${project.slug}`} class="project-card" data-category={category}>
	<div class="media">
		<img
			src={heroImage}
			alt={`Still from ${title}`}
			width="1600"
			height="900"
			loading={eager ? 'eager' : 'lazy'}
			decoding="async"
		/>
	</div>
	<div class="caption">
		<h3>{title}</h3>
		<span class="label">
			{category}{showClient && client ? ` · ${client}` : ''}
		</span>
	</div>
</a>

<style>
	.project-card {
		display: block;
		color: var(--text);
	}
	.project-card:hover {
		opacity: 1;
	}
	/* Every card frame is 16:9; the image fills it (use "contain" to letterbox instead) */
	.media {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #000;
	}
	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: opacity 0.25s ease;
	}
	.project-card:hover img,
	.project-card:focus-visible img {
		opacity: 0.8;
	}
	.caption {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 0.85rem;
	}
	h3 {
		margin: 0;
	}
	.label {
		text-align: right;
	}
</style>
