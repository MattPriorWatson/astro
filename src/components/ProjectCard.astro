---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
	/** Set true for above-the-fold cards so the image isn't lazy-loaded. */
	eager?: boolean;
}

const { project, eager = false } = Astro.props;
const { title, category, heroImage } = project.data;
---

<a href={`/projects/${project.slug}`} class="project-card">
	<div class="media">
		<img
			src={heroImage}
			alt={`Still from ${title}`}
			width="1600"
			height="900"
			loading={eager ? 'eager' : 'lazy'}
			decoding="async"
		/>
	</div>
	<div class="caption">
		<h3>{title}</h3>
		<span class="label">{category}</span>
	</div>
</a>

<style>
	.project-card {
		display: block;
		color: var(--text);
	}
	.project-card:hover {
		opacity: 1;
	}
	.media {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #000;
	}
	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: opacity 0.25s ease;
	}
	.project-card:hover img,
	.project-card:focus-visible img {
		opacity: 0.8;
	}
	.caption {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		margin-top: 1.1rem;
		text-align: center;
	}
	h3 {
		margin: 0;
	}
</style>