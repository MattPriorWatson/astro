---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
	/** Set true for above-the-fold cards so the image isn't lazy-loaded. */
	eager?: boolean;
	showClient?: boolean;
}

const { project, eager = false, showClient = false } = Astro.props;
const { title, category, client, heroImage } = project.data;
---

<a href={`/projects/${project.slug}`} class="project-card" data-category={category}>
	<div class="media">
		<img
			src={heroImage}
			alt={`Still from ${title}`}
			width="1600"
			height="1000"
			loading={eager ? 'eager' : 'lazy'}
			decoding="async"
		/>
	</div>
	<div class="overlay">
		<span class="meta">
			<span class="category">{category}</span>
			{showClient && client && <span class="client">{client}</span>}
		</span>
		<h3>{title}</h3>
	</div>
</a>

<style>
	.project-card {
		position: relative;
		display: block;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: var(--radius);
		background: #000;
		border: 1px solid var(--border);
		color: var(--text);
		transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease), border-color 0.3s ease;
	}
	.project-card:hover,
	.project-card:focus-visible {
		transform: translateY(-4px);
		box-shadow: var(--shadow);
		border-color: var(--border-strong);
		color: var(--text);
	}
	.media,
	img {
		width: 100%;
		height: 100%;
	}
	img {
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.6s var(--ease);
	}
	.project-card:hover img,
	.project-card:focus-visible img {
		transform: scale(1.04);
	}
	.overlay {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: clamp(1rem, 3vw, 1.75rem);
		background: linear-gradient(to top, rgba(14, 16, 19, 0.92) 0%, rgba(14, 16, 19, 0.3) 50%, transparent 100%);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.75rem;
		margin-bottom: 0.35rem;
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.category {
		color: var(--accent-text);
	}
	.client {
		color: var(--text-muted);
		font-weight: 400;
		letter-spacing: 0.06em;
	}
	.client::before {
		content: '•';
		margin-right: 0.75rem;
	}
	h3 {
		margin: 0;
		font-size: var(--text-h3);
		font-weight: 700;
	}

	@media (hover: none) {
		.project-card:hover {
			transform: none;
		}
	}
</style>
