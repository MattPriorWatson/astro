---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
	/** Set true for above-the-fold cards so the image isn't lazy-loaded. */
	eager?: boolean;
}

const { project, eager = false } = Astro.props;
const { title, category, heroImage, pubDate } = project.data;
const year = new Date(pubDate).getFullYear();
---

<a href={`/projects/${project.slug}`} class="project-card">
	<div class="media">
		<img
			src={heroImage}
			alt={`Still from ${title}`}
			width="1600"
			height="900"
			loading={eager ? 'eager' : 'lazy'}
			decoding="async"
		/>
	</div>
	<div class="caption">
		<div class="caption-meta">
			<span class="label">{category}</span>
			<span class="year">{year}</span>
		</div>
		<h3>{title}</h3>
	</div>
</a>

<style>
	.project-card {
		display: block;
		color: var(--text);
	}
	.project-card:hover {
		opacity: 1;
	}
	.media {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #111;
	}
	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.35s ease, opacity 0.25s ease;
	}
	.project-card:hover img,
	.project-card:focus-visible img {
		transform: scale(1.03);
		opacity: 0.85;
	}
	.caption {
		padding-top: 0.9rem;
	}
	.caption-meta {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.35rem;
	}
	.year {
		font-size: var(--text-xs);
		color: var(--text-muted);
		letter-spacing: 0.08em;
	}
	h3 {
		margin: 0;
		font-size: var(--text-h3);
	}
</style>