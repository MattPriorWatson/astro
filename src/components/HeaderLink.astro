---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
	/** Extra path prefixes that should also mark this link as active (e.g. "/projects" for "/work"). */
	matches?: string[];
}

const { href, class: className, matches = [], ...props } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const target = String(href);
const prefixes = [target, ...matches].filter((p) => p !== '/');
const isActive = target === '/' ? path === '/' : prefixes.some((p) => path === p || path.startsWith(`${p}/`));
---

<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}>
	<slot />
</a>
