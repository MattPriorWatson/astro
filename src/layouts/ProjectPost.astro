---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'projects'>['data'];

const { title, description, pubDate, client, category, videoUrl, heroImage, beforeImage, afterImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				max-width: 1000px;
				margin: 0 auto;
				padding: 7em 1em 4em 1em;
			}
			.meta-bar {
				display: flex;
				gap: 2em;
				margin: 1.5em 0 2.5em 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.05);
				padding-bottom: 1.5em;
			}
			.video-wrapper {
				position: relative;
				padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
				height: 0;
				overflow: hidden;
				border-radius: 8px;
				margin-bottom: 3em;
				background: #000;
			}
			.video-wrapper iframe {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				border: 0;
			}
			.stills-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.5em;
				margin: 2.5em 0;
			}
			.still-container {
				position: relative;
			}
			.still-label {
				position: absolute;
				bottom: 10px;
				left: 10px;
				background: rgba(0, 0, 0, 0.75);
				padding: 4px 8px;
				border-radius: 4px;
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			@media (max-width: 720px) {
				.stills-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<h1>{title}</h1>
				<div class="meta-bar">
					<span><strong>Category:</strong> {category}</span>
					{client && <span><strong>Client:</strong> {client}</span>}
					<span><strong>Date:</strong> <FormattedDate date={pubDate} /></span>
				</div>

				{videoUrl && (
					<div class="video-wrapper">
						<iframe src={videoUrl} title={title} allowfullscreen></iframe>
					</div>
				)}

				{(beforeImage || afterImage) && (
					<h3>Grade Comparison</h3>
					<div class="stills-grid">
						{beforeImage && (
							<div class="still-container">
								<img src={beforeImage} alt="LOG / Ungraded Still" />
								<span class="still-label">LOG / Before</span>
							</div>
						)}
						{afterImage && (
							<div class="still-container">
								<img src={afterImage} alt="Graded Still" />
								<span class="still-label">Graded / After</span>
							</div>
						)}
					</div>
				)}

				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>