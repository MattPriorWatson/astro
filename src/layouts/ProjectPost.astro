---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import VideoEmbed from '../components/VideoEmbed.astro';

type Props = CollectionEntry<'projects'>['data'];

const { title, description, pubDate, client, category, videoUrl, heroImage, galleryImages = [] } = Astro.props;
const gallery = galleryImages.slice(0, 6);
---

<BaseLayout title={title} description={description} image={heroImage} type="article">
	<article>
		<a class="back-link text-link" href="/work">← All work</a>

		<header class="project-header">
			<span class="eyebrow">{category}</span>
			<h1>{title}</h1>
			<dl class="meta-bar">
				{
					client && (
						<div>
							<dt>Client</dt>
							<dd>{client}</dd>
						</div>
					)
				}
				<div>
					<dt>Date</dt>
					<dd><FormattedDate date={pubDate} /></dd>
				</div>
			</dl>
		</header>

		<div class="overview">
			<slot />
		</div>

		{videoUrl && <div class="video-block"><VideoEmbed src={videoUrl} title={title} /></div>}

		{
			gallery.length > 0 && (
				<section aria-labelledby="gallery-heading">
					<h2 id="gallery-heading" class="section-title gallery-title">Stills</h2>
					<ul class="image-gallery">
						{gallery.map((src, index) => (
							<li>
								<button type="button" class="gallery-item" data-index={index} aria-label={`View still ${index + 1} of ${gallery.length} full size`}>
									<img src={src} alt={`${title} still ${index + 1}`} width="1600" height="900" loading="lazy" decoding="async" />
								</button>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</article>

	<dialog id="lightbox" class="lightbox" aria-label="Image viewer">
		<button type="button" class="lb-btn lb-close" aria-label="Close">×</button>
		<button type="button" class="lb-btn lb-prev" aria-label="Previous still">‹</button>
		<img id="lightbox-img" alt="" />
		<button type="button" class="lb-btn lb-next" aria-label="Next still">›</button>
		<p id="lightbox-caption" class="lb-caption" aria-live="polite"></p>
	</dialog>
</BaseLayout>

<style>
	.back-link {
		display: inline-block;
		margin-bottom: 1.5rem;
		color: var(--text-muted);
	}
	.back-link:hover {
		color: var(--text);
	}

	.project-header {
		margin-bottom: 2rem;
	}
	.project-header h1 {
		margin-bottom: 1rem;
	}

	.meta-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 2.5rem;
		margin: 0;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border);
	}
	.meta-bar dt {
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.meta-bar dd {
		margin: 0;
		color: var(--text);
	}

	.overview {
		max-width: 62ch;
		margin-bottom: clamp(2rem, 6vw, 3.5rem);
		font-size: var(--text-lg);
		line-height: 1.8;
	}
	.video-block {
		margin-bottom: clamp(2.5rem, 7vw, 4rem);
	}

	.gallery-title {
		margin-bottom: 1.5rem;
	}
	.image-gallery {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: clamp(0.75rem, 2vw, 1.25rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.gallery-item {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		padding: 0;
		overflow: hidden;
		background: #000;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		cursor: zoom-in;
	}
	.gallery-item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.4s var(--ease);
	}
	.gallery-item:hover img {
		transform: scale(1.03);
	}

	/* Lightbox */
	.lightbox {
		width: 100vw;
		max-width: 100vw;
		height: 100vh;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: rgba(8, 9, 11, 0.96);
		color: var(--text);
	}
	.lightbox[open] {
		display: grid;
		place-items: center;
	}
	.lightbox::backdrop {
		background: rgba(8, 9, 11, 0.96);
	}
	.lightbox img {
		max-width: min(100vw - 2rem, 1800px);
		max-height: calc(100dvh - 6rem);
		width: auto;
		height: auto;
		object-fit: contain;
		border-radius: var(--radius-sm);
	}
	.lb-btn {
		position: absolute;
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		padding: 0 0 4px;
		font: inherit;
		font-size: 2rem;
		line-height: 1;
		color: var(--text);
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		cursor: pointer;
		transition: background-color 0.2s ease;
	}
	.lb-btn:hover {
		background: rgba(255, 255, 255, 0.18);
	}
	.lb-close {
		top: 1rem;
		right: 1rem;
	}
	.lb-prev,
	.lb-next {
		top: 50%;
		transform: translateY(-50%);
	}
	.lb-prev {
		left: 1rem;
	}
	.lb-next {
		right: 1rem;
	}
	.lb-caption {
		position: absolute;
		bottom: 1rem;
		left: 0;
		right: 0;
		margin: 0;
		text-align: center;
		font-size: var(--text-sm);
		color: var(--text-muted);
	}

	@media (max-width: 640px) {
		.image-gallery {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
	const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
	const caption = document.getElementById('lightbox-caption');
	const items = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery-item'));
	let current = 0;

	function show(index: number) {
		if (!img || !caption || items.length === 0) return;
		current = (index + items.length) % items.length;
		const source = items[current].querySelector('img');
		img.src = source?.currentSrc || source?.src || '';
		img.alt = source?.alt ?? '';
		caption.textContent = `${current + 1} / ${items.length}`;
	}

	if (dialog && items.length > 0) {
		items.forEach((btn, i) =>
			btn.addEventListener('click', () => {
				show(i);
				dialog.showModal();
				document.documentElement.style.overflow = 'hidden';
			})
		);
		dialog.addEventListener('close', () => {
			document.documentElement.style.overflow = '';
			items[current]?.focus();
		});
		dialog.querySelector('.lb-close')?.addEventListener('click', () => dialog.close());
		dialog.querySelector('.lb-prev')?.addEventListener('click', () => show(current - 1));
		dialog.querySelector('.lb-next')?.addEventListener('click', () => show(current + 1));
		// Click on the backdrop (outside the image and buttons) closes it
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog.close();
		});
		dialog.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') show(current - 1);
			if (e.key === 'ArrowRight') show(current + 1);
		});
	}
</script>
