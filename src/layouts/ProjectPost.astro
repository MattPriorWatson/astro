---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import Gallery from '../components/Gallery.astro';

type Props = CollectionEntry<'projects'>['data'];

const { title, description, pubDate, client, category, videoUrl, heroImage, galleryImages = [] } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage} type="article">
	<article>
		<a class="back-link text-link" href="/work">← All work</a>

		<header class="project-header">
			<span class="eyebrow">{category}</span>
			<h1>{title}</h1>
			<p class="meta">
				{client && <span>{client}</span>}
				<FormattedDate date={pubDate} />
			</p>
		</header>

		<div class="overview">
			<slot />
		</div>

		{videoUrl && <div class="video-block"><VideoEmbed src={videoUrl} title={title} /></div>}

		<Gallery images={galleryImages.slice(0, 6)} title={title} />
	</article>
</BaseLayout>

<style>
	.back-link {
		display: inline-block;
		margin-bottom: 2.5rem;
	}

	.project-header {
		margin-bottom: 2rem;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.5rem;
		margin: 1rem 0 0;
		font-size: var(--text-sm);
		color: var(--text-muted);
	}

	.overview {
		max-width: 60ch;
		margin-bottom: clamp(2.5rem, 7vw, 4.5rem);
		line-height: 1.8;
	}
	.video-block {
		margin-bottom: clamp(0.5rem, 1.5vw, 1rem);
	}
</style>
