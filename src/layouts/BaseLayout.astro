---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	type?: 'website' | 'article';
	/** Max content width. Defaults to 'default' (1200px). */
	width?: 'narrow' | 'default' | 'wide';
}

const { title, description, image, type, width = 'default' } = Astro.props;
const containerClass = width === 'default' ? 'container' : `container container--${width}`;
---

<!doctype html>
<html lang="en-GB">
	<head>
		<BaseHead title={title} description={description} image={image} type={type} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Header />
		<main id="main" class="page">
			<div class={containerClass}>
				<slot />
			</div>
		</main>
		<Footer />
	</body>
</html>
